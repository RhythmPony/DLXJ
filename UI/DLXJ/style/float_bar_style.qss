#float_bar{
    border:none;
    border-radius:16px;
    background-color:#E0CDCA;
}
QToolButton{
    border:none;
    border-radius:4px;
    background-color:#33E4AFA9;
}
QToolButton:hover{
    background-color:#E4AFA9;
}
#sld_stroke_weight{
    background-color:#E0CDCA;
}
#cb_brush_shape{
    border:none;
    background-color:#E0CDCA;
}
QComboBox::drop-down{
    border:none;
    border-radius:4px;
    background-color:#33E4AFA9;
}
QComboBox::drop-down:hover{
    border:none;
    border-radius:4px;
    background-color:#E4AFA9;
}
QComboBox::down-arrow {
    image: url(:/assets/icon/combo_box_arrow.png);
    width:20px;
}
QLabel{
    border:none;
    border-radius:4px;
}
