#frm_rich_text{
    border:none;
    border-radius:4px;
    background-color:white;
}
QToolButton{
    border:none;
    border-radius:4px;
    background-color:#33E4AFA9;
}
QToolButton:hover{
    background-color:#E4AFA9;
}
QToolButton:checked{
    background-color:#F0776A;
}
QComboBox{
    border:none;
    background-color:#33E4AFA9;
}
QComboBox::drop-down{
    border:none;
    border-radius:4px;
    background-color:#66CCCCCC;
}
QComboBox::drop-down:hover{
    border:none;
    border-radius:4px;
    background-color:#CCCCCC;
}
QComboBox::down-arrow {
    image: url(:/assets/icon/combo_box_arrow.png);
    width:20px;
}
